{
  "name": "@rtzll/reflow",
  "version": "0.16.1",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./diffs": {
      "types": "./dist/diffs.d.ts",
      "default": "./dist/diffs.js"
    },
    "./diffs/ssr": {
      "types": "./dist/diffs-ssr.d.ts",
      "default": "./dist/diffs-ssr.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@pierre/diffs": "^1.7.0",
    "@shikijs/transformers": "^4.6.0",
    "remix": "3.3.0",
    "shiki": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@pierre/diffs": {
      "optional": true
    },
    "@shikijs/transformers": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pierre/diffs": "1.7.1",
    "@shikijs/transformers": "4.6.0",
    "remix": "3.3.0",
    "shiki": "4.6.0"
  },
  "dependencies": {
    "@remix-run/ui": "0.14.0",
    "marked": "18.2.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtzll/reflow.git",
    "directory": "packages/reflow"
  },
  "description": "Native Remix 3 components with fluid motion, shared hover, and keyboard-friendly controls.",
  "author": "Christian Rotzoll",
  "keywords": [
    "remix",
    "components",
    "ui",
    "motion",
    "accessibility"
  ],
  "homepage": "https://github.com/rtzll/reflow#readme",
  "bugs": {
    "url": "https://github.com/rtzll/reflow/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
