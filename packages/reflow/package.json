{
  "name": "@rtzll/reflow",
  "version": "0.11.0",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/*.css dist/ && node scripts/bundle-markdown.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@shikijs/transformers": "^4.6.0",
    "remix": "3.3.0",
    "shiki": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@shikijs/transformers": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shikijs/transformers": "4.6.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "esbuild": "0.28.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remix": "3.3.0",
    "shiki": "4.6.0",
    "unified": "11.0.5"
  },
  "dependencies": {
    "@remix-run/ui": "0.14.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtzll/reflow.git",
    "directory": "packages/reflow"
  },
  "description": "Native Remix 3 components with fluid motion, shared hover, and keyboard-friendly controls.",
  "author": "Christian Rotzoll",
  "keywords": [
    "remix",
    "components",
    "ui",
    "motion",
    "accessibility"
  ],
  "homepage": "https://github.com/rtzll/reflow#readme",
  "bugs": {
    "url": "https://github.com/rtzll/reflow/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
