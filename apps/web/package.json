{
  "name": "@reflow/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import remix/node-tsx server.ts",
    "start": "node --import remix/node-tsx server.ts",
    "build": "node tools/build.mjs",
    "preview": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler dev --local --ip 127.0.0.1 --port 44101",
    "types": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler types worker/env.d.ts --include-runtime=false",
    "test:deployment": "node tools/test-deployment.mjs",
    "deploy:dry-run": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir build/dry-run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@rtzll/reflow": "workspace:*",
    "@shikijs/transformers": "4.5.0",
    "cuelume": "0.2.8",
    "remix": "3.2.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
