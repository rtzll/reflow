{
  "name": "reflow-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "dev": "pnpm build && pnpm --filter @reflow/web dev",
    "starter": "node tools/create-starter.ts",
    "build": "pnpm --filter @rtzll/reflow --filter @rtzll/create-reflow build",
    "build:web": "pnpm build && pnpm --filter @reflow/web build",
    "preview:web": "pnpm build:web && pnpm --filter @reflow/web preview",
    "test:deployment": "pnpm build:web && pnpm --filter @reflow/web test:deployment",
    "check": "pnpm build && pnpm -r check && tsc -p tsconfig.json",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "format": "pnpm run fmt",
    "format:check": "pnpm run fmt:check",
    "lint": "oxlint . --max-warnings=0",
    "lint:fix": "oxlint . --fix --max-warnings=0",
    "test": "pnpm build:web && pnpm test:run",
    "test:linux": "node tools/test-linux.ts",
    "test:package": "pnpm build && node tools/check-package.ts",
    "test:stress": "node tools/test-stress.ts",
    "test:run": "node --test tools/*.test.ts packages/create-reflow/test/*.test.ts && ./apps/web/node_modules/.bin/remix test --type server --type browser && ./apps/web/node_modules/.bin/remix test --type e2e --concurrency 3 --setup apps/web/test/showcase-server.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtzll/reflow.git"
  }
}
