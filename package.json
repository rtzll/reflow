{
  "name": "reflow-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "pnpm build && pnpm --filter @reflow/web dev",
    "starter": "node tools/create-starter.mjs",
    "build": "pnpm --filter @rtzll/reflow build",
    "check": "pnpm build && pnpm -r check",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --max-warnings=0",
    "lint:fix": "oxlint . --fix --max-warnings=0",
    "test": "pnpm build && pnpm test:run",
    "test:package": "pnpm build && node tools/check-package.mjs",
    "test:run": "node --test tools/release.test.mjs && ./apps/web/node_modules/.bin/remix test"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.92.0",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtzll/reflow.git"
  }
}
