{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "nursery": "off",
    "pedantic": "off",
    "perf": "off",
    "restriction": "off",
    "style": "off",
    "suspicious": "off"
  },
  "env": {
    "builtin": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "ignorePatterns": ["**/*.d.ts", "**/dist/**", "**/coverage/**", "node_modules/**", ".claude/**"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "plugins": ["typescript", "import"],
      "rules": {
        "@typescript-eslint/consistent-type-imports": [
          "error",
          {
            "prefer": "type-imports",
            "fixStyle": "separate-type-imports"
          }
        ],
        "@typescript-eslint/consistent-type-exports": [
          "error",
          {
            "fixMixedExportsWithInlineTypeSpecifier": false
          }
        ],
        "import/extensions": [
          "error",
          "always",
          {
            "ignorePackages": true
          }
        ]
      }
    },
    {
      "files": ["**/*.{ts,tsx,js,jsx}"],
      "rules": {
        "no-var": "error",
        "arrow-body-style": ["error", "as-needed"]
      }
    },
    {
      "files": ["packages/reflow/src/**/*.{ts,tsx}"],
      "rules": {
        "no-console": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@pierre/diffs", "@pierre/diffs/*"],
                "message": "Optional peer @pierre/diffs may only be imported from diffs.tsx or diffs-ssr.ts."
              },
              {
                "group": ["@pierre/trees", "@pierre/trees/*", "preact", "preact/*"],
                "message": "Optional peers @pierre/trees and preact may only be imported from trees.tsx or trees-ssr.ts."
              },
              {
                "group": ["pele", "pele/*"],
                "message": "Optional peer pele may only be imported from diagrams.tsx or diagrams-ssr.ts."
              },
              {
                "group": ["shiki", "shiki/*", "@shikijs/*"],
                "message": "Optional peer shiki may only be imported from highlight.ts."
              },
              {
                "group": ["marked", "marked/*"],
                "message": "marked may only be imported from markdown.tsx."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/reflow/src/diffs.tsx",
        "packages/reflow/src/diffs-ssr.ts",
        "packages/reflow/src/trees.tsx",
        "packages/reflow/src/trees-ssr.ts",
        "packages/reflow/src/diagrams.tsx",
        "packages/reflow/src/diagrams-ssr.ts",
        "packages/reflow/src/highlight.ts",
        "packages/reflow/src/markdown.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
